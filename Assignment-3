# ==================================================
# STAGE 6: GENERATE LARGE TEST DATA
# ==================================================

def generate_contacts(total):

    contacts = []

    for i in range(total):

        contacts.append({
            "name": "Person " + str(i),
            "phone": str(9000000000 + i),
            "email": "person" + str(i) + "@gmail.com"
        })

    return contacts


# ==================================================
# STAGE 7: PERFORMANCE MEASUREMENT
# ==================================================

def performance_test():

    print("\nPERFORMANCE TEST")
    print("=" * 50)

    for size in [1000, 100000]:

        contacts = generate_contacts(size)

        # Dictionary method
        start = time.perf_counter()

        dictionary_result = merge_contacts([contacts])

        dictionary_time = time.perf_counter() - start

        # Pairwise method
        start = time.perf_counter()

        pairwise_result, comparisons = pairwise_merge(
            [contacts]
        )

        pairwise_time = time.perf_counter() - start

        print("\nCONTACTS:", size)

        print("Dictionary method:")
        print("Groups:", len(dictionary_result))
        print("Time:", round(dictionary_time, 6), "seconds")

        print("\nPairwise method:")
        print("Groups:", len(pairwise_result))
        print("Comparisons:", comparisons)
        print("Time:", round(pairwise_time, 6), "seconds")

        print("\nRESULT VALIDATION:",
              len(dictionary_result) == len(pairwise_result))

        print("-" * 50)


