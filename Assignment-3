# STAGE 1: NORMALISATION
# ==================================================

def normalize_number(number):

    if not number:
        return ""

    # Keep only digits
    digits = ""

    for char in number:
        if char.isdigit():
            digits += char

    # Remove Indian country code 91
    if len(digits) == 12 and digits.startswith("91"):
        digits = digits[2:]

    return digits


def normalize_name(name):

    if not name:
        return ""

    # Convert to lowercase and remove extra spaces
    return " ".join(name.lower().split())


def normalize_email(email):

    if not email:
        return ""

    return email.strip().lower()


# ==================================================
# STAGE 2: DICTIONARY-BASED CONTACT MERGING
# ==================================================

def merge_contacts(contact_lists):

    merged = {}

    for contact_list in contact_lists:

        for contact in contact_list:

            name = contact.get("name", "").strip()
            number = normalize_number(
                contact.get("phone", "")
            )
            email = normalize_email(
                contact.get("email", "")
            )

            # Ignore contacts without phone numbers
            if not number:
                continue

            # Dictionary key is normalized phone number
            if number not in merged:

                merged[number] = {
                    "name": set(),
                    "numbers": set(),
                    "emails": set()
                }

            # Add information without duplication
            if name:
                merged[number]["name"].add(name)

            if number:
                merged[number]["numbers"].add(number)

            if email:
                merged[number]["emails"].add(email)

    return merged


# ==================================================
# STAGE 3: ORIGINAL PAIRWISE COMPARISON
# ==================================================

def pairwise_merge(contact_lists):

    contacts = []

    for contact_list in contact_lists:
        contacts.extend(contact_list)

    groups = []
    comparisons = 0

    for contact in contacts:

        number = normalize_number(
            contact.get("phone", "")
        )

        if not number:
            continue

        found = False

        for group in groups:

            comparisons += 1

            if number in group["numbers"]:

                name = contact.get("name", "").strip()
                email = normalize_email(
                    contact.get("email", "")
                )

                if name:
                    group["name"].add(name)

                if email:
                    group["emails"].add(email)

                group["numbers"].add(number)

                found = True
                break

        if not found:

            name = contact.get("name", "").strip()
            email = normalize_email(
                contact.get("email", "")
            )

            groups.append({
                "name": {name} if name else set(),
                "numbers": {number},
                "emails": {email} if email else set()
            })

    return groups, comparisons


# ==================================================
# STAGE 4: DISPLAY MERGED CONTACTS
# ==================================================

def display_contacts(merged):

    print("\nMERGED CONTACTS")
    print("=" * 50)

    for number, details in merged.items():

        print("Names:", sorted(details["name"]))
        print("Phone numbers:", sorted(details["numbers"]))
        print("Emails:", sorted(details["emails"]))
        print("-" * 50)


