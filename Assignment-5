def create_50_complaints():

    examples = [
        ("The road is clean and the bus is fast.", "positive"),
        ("The staff are helpful and friendly.", "positive"),
        ("The service is excellent and quick.", "positive"),
        ("The station is clean and comfortable.", "positive"),
        ("The service improved and became better.", "positive"),

        ("The road is dirty and the bus is slow.", "negative"),
        ("The staff are rude and unhelpful.", "negative"),
        ("The factory smoke is bad and unsafe.", "negative"),
        ("The bus is broken and late.", "negative"),
        ("The service is poor and damaged.", "negative")
    ]

    complaints = []

    for i in range(5):

        for sentence, human_label in examples:

            complaints.append({
                "text": sentence,
                "human_label": human_label
            })

    return complaints


# ==========================================================
# COMPARE AI LABELS WITH HUMAN LABELS
# ==========================================================

def validate_sentiment(complaints):

    correct = 0
    total = len(complaints)

    print("\nHUMAN VS PROGRAM COMPARISON")
    print("-" * 55)

    for complaint in complaints:

        text = complaint["text"]
        human = complaint["human_label"]

        predicted = label(text)

        if predicted == human:
            correct += 1

    agreement = (correct / total) * 100

    print("Total complaints:", total)
    print("Correct predictions:", correct)
    print("Incorrect predictions:", total - correct)

    print("Human agreement:", round(agreement, 2), "%")

    return agreement


