# ==========================================================
# B4.1 - FREQUENCY-BASED SUMMARISER
# ==========================================================

def frequency_summary(text, k=3):

    sentences = re.split(r'(?<=[.!?])\s+', text.strip())

    words = re.findall(r"[a-zA-Z]+", text.lower())

    important_words = [
        word for word in words
        if word not in STOPWORDS
    ]

    word_frequency = Counter(important_words)

    sentence_scores = []

    for index, sentence in enumerate(sentences):

        sentence_words = re.findall(
            r"[a-zA-Z]+",
            sentence.lower()
        )

        sentence_score = sum(
            word_frequency[word]
            for word in sentence_words
            if word not in STOPWORDS
        )

        sentence_scores.append(
            (sentence_score, index, sentence)
        )

    # Select sentences with highest scores
    selected = sorted(
        sentence_scores,
        key=lambda x: (-x[0], x[1])
    )[:k]

    # Restore original sentence order
    selected.sort(key=lambda x: x[1])

    return " ".join(item[2] for item in selected)


# ==========================================================
# ALTERNATIVE - FIRST K SENTENCES
# ==========================================================

def first_k_summary(text, k=3):

    sentences = re.split(r'(?<=[.!?])\s+', text.strip())

    return " ".join(sentences[:k])


