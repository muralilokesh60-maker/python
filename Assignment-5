# B4.2 - CREATE DATABASE
# ==========================================================

DATABASE = "complaints.db"


def create_database():

    if os.path.exists(DATABASE):
        os.remove(DATABASE)

    connection = sqlite3.connect(DATABASE)

    cursor = connection.cursor()

    cursor.execute("""
        CREATE TABLE complaints (
            complaint_id INTEGER PRIMARY KEY,
            station_id INTEGER,
            complaint_day TEXT,
            complaint_text TEXT,
            sentiment TEXT
        )
    """)

    connection.commit()

    return connection


# ==========================================================
# GENERATE 50,000 COMPLAINTS
# 100 STATIONS
# ==========================================================

def generate_database_data(connection):

    cursor = connection.cursor()

    random.seed(42)

    complaints = [
        "The bus service is good and fast.",
        "The station is dirty and the bus is slow.",
        "The staff are helpful.",
        "The factory smoke is bad.",
        "The road is clean.",
        "The bus is broken and late."
    ]

    data = []

    for i in range(50000):

        station_id = random.randint(1, 100)

        day = random.randint(1, 30)

        complaint_day = f"2026-11-{day:02d}"

        text = random.choice(complaints)

        sentiment = label(text)

        data.append((
            station_id,
            complaint_day,
            text,
            sentiment
        ))

    cursor.executemany("""
        INSERT INTO complaints
        (station_id, complaint_day,
         complaint_text, sentiment)
        VALUES (?, ?, ?, ?)
    """, data)

    connection.commit()

    print("\nDATABASE CREATED")
    print("Total complaints:", len(data))
    print("Stations:", 100)


# ==========================================================
# B4.2 - MEASURE SLOWEST QUERY BEFORE AND AFTER INDEX
# ==========================================================

def measure_query(connection):

    cursor = connection.cursor()

    station = 50
    day = "2026-11-15"

    query = """
        SELECT *
        FROM complaints
        WHERE station_id = ?
        AND complaint_day = ?
    """

    repetitions = 200

    # ---------------------------------------
    # BEFORE INDEX
    # ---------------------------------------

    start = time.perf_counter()

    for i in range(repetitions):

        cursor.execute(query, (station, day))
        result = cursor.fetchall()

    before_time = time.perf_counter() - start

    print("\nDATABASE QUERY - BEFORE INDEX")
    print("Matching records:", len(result))
    print("Execution time:",
          round(before_time, 6), "seconds")

    # ---------------------------------------
    # CREATE COMPOSITE INDEX
    # ---------------------------------------

    cursor.execute("""
        CREATE INDEX idx_station_day
        ON complaints(station_id, complaint_day)
    """)

    connection.commit()

    # ---------------------------------------
    # AFTER INDEX
    # ---------------------------------------

    start = time.perf_counter()

    for i in range(repetitions):

        cursor.execute(query, (station, day))
        result_after = cursor.fetchall()

    after_time = time.perf_counter() - start

    print("\nDATABASE QUERY - AFTER INDEX")
    print("Matching records:", len(result_after))
    print("Execution time:",
          round(after_time, 6), "seconds")

    if before_time > 0:

        improvement = (
            (before_time - after_time) / before_time
        ) * 100

        print("Time reduction:",
              round(improvement, 2), "%")

    # Verify that the index exists
    cursor.execute("""
        PRAGMA index_list('complaints')
    """)

    print("\nDATABASE INDEX DETAILS:")
    print(cursor.fetchall())


