POSITIVE = {
    "good", "clean", "fast", "helpful", "improved",
    "excellent", "great", "quick", "friendly",
    "better", "efficient", "comfortable", "nice"
}

NEGATIVE = {
    "bad", "dirty", "slow", "rude", "smoke",
    "broken", "poor", "late", "worst",
    "unhelpful", "damaged", "unsafe"
}

NEGATORS = {"not", "never", "no"}

STOPWORDS = {
    "the", "is", "a", "an", "and", "or", "to",
    "of", "in", "on", "was", "were", "are",
    "it", "this", "that", "from", "for", "with",
    "my", "our", "but", "very", "has", "have"
}


# ==========================================================
# B4.1 - SENTIMENT SCORER
# ==========================================================

def score(text):
    """
    +1 for positive words
    -1 for negative words
    0 for neutral words
    A preceding negator reverses the sentiment.
    """

    words = re.findall(r"[a-zA-Z]+", text.lower())

    total = 0

    for i, word in enumerate(words):

        if word in POSITIVE:
            value = 1

        elif word in NEGATIVE:
            value = -1

        else:
            value = 0

        # Reverse sentiment if immediately preceded
        # by a negator.
        if i > 0 and words[i - 1] in NEGATORS:
            value = -value

        total += value

    return total


# ==========================================================
# SENTIMENT LABEL FUNCTION
# ==========================================================

def label(text):

    s = score(text)

    if s > 0:
        return "positive"

    elif s < 0:
        return "negative"

    else:
        return "neutral"


